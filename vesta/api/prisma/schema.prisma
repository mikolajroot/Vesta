generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Room {
  id         Int       @id(map: "ROOM_pkey") @unique(map: "ROOM_id_key") @default(autoincrement())
  name       String    @db.VarChar
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  type       RoomType
  floor      Int?      @default(0)
  area       Decimal   @default(0.0) @db.Decimal
  home_id    Int
  Devices    Devices[]
  Home       Home      @relation(fields: [home_id], references: [id], onDelete: Cascade)

  @@unique([name, home_id], map: "ROOM_name_home_id_key")
}

model Users {
  id       Int    @id @unique @default(autoincrement())
  username String @unique(map: "Users_name_key") @db.VarChar
  password String @db.VarChar
  role     Roles
  Home     Home[]
}

model Home {
  id          Int    @id @default(autoincrement())
  name        String @db.VarChar
  users_id    Int[]
  invite_code String @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_id    Int
  Users       Users  @relation(fields: [owner_id], references: [id], onDelete: Cascade)
  Room        Room[]
}

model Devices {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar
  type       String   @db.VarChar
  status     String?  @db.VarChar
  room_id    Int
  mqtt_topic String?  @db.VarChar
  created_at DateTime @default(now()) @db.Timestamptz(6)
  energy_kwh Float    @default(0)
  power_w    Float    @default(0)
  Room       Room     @relation(fields: [room_id], references: [id], onDelete: Cascade)
}

enum RoomType {
  LIVING_ROOM
  BEDROOM
  KITCHEN
  BATHROOM
  GARAGE
}

enum Roles {
  Admin
  Child
}
