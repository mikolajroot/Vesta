generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model ROOM {
  id         BigInt   @id(map: "ROOM_pkey") @default(autoincrement())
  name       String   @unique(map: "ROOM_name_key") @default("") @db.VarChar
  created_at DateTime @default(now()) @db.Timestamptz(6)
}
