generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Room {
  id         Int       @id(map: "ROOM_pkey") @unique(map: "ROOM_id_key") @default(autoincrement())
  name       String    @unique(map: "ROOM_name_key") @db.VarChar
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  type       RoomType?
  floor      Int?      @default(0)
  area       Decimal   @default(0.0) @db.Decimal
}

model Users {
  id       Int    @id @unique @default(autoincrement())
  username String @unique(map: "Users_name_key") @db.VarChar
  password String @db.VarChar
  role     Roles
}

enum RoomType {
  LIVING_ROOM
  BEDROOM
  KITCHEN
  BATHROOM
  GARAGE
}

enum Roles {
  Admin
  Child
}
