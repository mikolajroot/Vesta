generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model ROOMS {
  id         BigInt   @id @default(autoincrement())
  name       String   @unique @default("") @db.VarChar
  created_at DateTime @default(now()) @db.Timestamptz(6)
}
